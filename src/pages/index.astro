---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const capabilities = [
  { number: '01', title: 'Islamic learning', text: 'Age-appropriate learning experiences connected to faith, adab, and everyday life.' },
  { number: '02', title: 'Language learning', text: 'Practical English and Arabic learning through familiar characters, stories, and repetition.' },
  { number: '03', title: 'Stories and books', text: 'Creative stories, reading experiences, and educational materials made for young learners and families.' },
  { number: '04', title: 'Digital experiences', text: 'Thoughtful digital products and future learning tools built around practical educational needs.' }
];
const projects = [
  { label: 'Islamic learning', title: 'Aya The Little Muslim', text: 'Stories, Islamic learning, duʿā, and everyday character development through Aya’s world.', href: `${base}aya/aya-the-little-muslim/` },
  { label: 'Language learning', title: 'Aya Fun Lingua', text: 'A familiar and accessible approach to learning English and Arabic through stories and daily language.', href: `${base}aya/aya-fun-lingua/` },
  { label: 'Books and activities', title: 'Aya Books', text: 'Reading, activity, and printable experiences that can extend learning beyond the screen.', href: `${base}products/aya-books/` }
];
---

<BaseLayout title="Lumma Creative Studio | Creative Learning for Muslim Families" description="Lumma Creative Studio develops stories, books, learning resources and digital experiences for Muslim families.">
  <section class="hero home-hero"><div class="container hero-grid"><div class="hero-copy">
    <span class="eyebrow">Lumma Creative Studio</span><p class="hero-kicker">Faith · Language · Stories · Family</p>
    <h1 class="display" data-i18n-key="home.hero.title">Creative learning that belongs in everyday family life.</h1>
    <p class="lead hero-lead" data-i18n-key="home.hero.lead">We develop thoughtful learning experiences for Muslim families through stories, Islamic education, language learning, books, activities, and digital products.</p>
    <div class="button-row"><a class="button button-primary" href={`${base}aya/`} data-i18n-key="home.hero.meetAya">Meet Aya</a><a class="button button-secondary" href={`${base}products/`} data-i18n-key="home.hero.explore">Explore our work</a></div>
    <div class="hero-trust-row"><span>Designed for families</span><span>Built to grow</span><span>Rooted in meaningful learning</span></div>
  </div><div class="hero-world" aria-label="A visual introduction to the Aya learning universe"><div class="world-sun"></div><div class="world-cloud cloud-one"></div><div class="world-cloud cloud-two"></div><div class="world-card world-card-main"><span class="world-label">The Aya universe</span><strong>One familiar world.<br />Many ways to learn.</strong><p>Stories can connect with books, activities, language practice, and shared family experiences.</p></div><div class="world-orbit orbit-faith">Faith</div><div class="world-orbit orbit-language">Language</div><div class="world-orbit orbit-family">Family</div></div></div></section>

  <section class="section intro-band"><div class="container intro-grid"><span class="eyebrow">What Lumma is building</span><div><h2 class="title" data-i18n-key="home.intro.title">An interconnected learning ecosystem, not just a collection of content.</h2><p class="lead" data-i18n-key="home.intro.lead">Lumma brings different formats together around a shared educational direction. A story can lead to a book, an activity, a conversation, a language lesson, or a new digital learning experience.</p></div></div></section>

  <section class="section section-soft capabilities-section"><div class="container"><div class="section-heading"><div><span class="eyebrow" data-i18n-key="home.create">What we create</span><h2 class="title" data-i18n-key="home.create.title">Different formats. One educational direction.</h2></div><p>We are building an adaptable studio structure so that useful ideas can take the form most appropriate to the learner and the family.</p></div><div class="capability-grid">{capabilities.map((item) => (<article class="capability-card"><span class="capability-number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>

  <section class="section aya-home-section"><div class="container aya-home-grid"><div class="aya-home-copy"><span class="eyebrow" data-i18n-key="home.aya">Meet Aya</span><h2 class="title" data-i18n-key="home.aya.title">A familiar character at the heart of a growing learning world.</h2><p class="lead" data-i18n-key="home.aya.lead">Aya is the central creative and educational universe within Lumma. Through familiar characters and everyday experiences, different forms of beneficial learning can connect naturally.</p><a class="text-link" href={`${base}aya/`} data-i18n-key="home.discoverAya">Discover the Aya universe</a></div><div class="aya-ecosystem-map"><div class="aya-core">AYA</div><div class="aya-node node-top">Stories</div><div class="aya-node node-right">Language</div><div class="aya-node node-bottom">Books & Activities</div><div class="aya-node node-left">Family Learning</div></div></div></section>

  <section class="section projects-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Explore the ecosystem</span><h2 class="title">Projects taking shape around Aya.</h2></div><a class="text-link" href={`${base}products/`}>View products <span aria-hidden="true">→</span></a></div><div class="project-grid">{projects.map((project, index) => (<article class={`project-card project-card-${index + 1}`}><span class="tag">{project.label}</span><div><h3>{project.title}</h3><p>{project.text}</p></div><a href={project.href} aria-label={`Explore ${project.title}`}>Explore <span aria-hidden="true">→</span></a></article>))}</div></div></section>

  <section class="section family-section"><div class="container family-grid"><div class="family-copy"><span class="eyebrow">For families</span><h2 class="title">Learning should continue beyond the screen or page.</h2><p class="lead">We want stories and resources to support conversations, habits, activities, and small moments of learning in everyday family life.</p></div><div class="family-steps"><div><span>01</span><strong>Discover</strong><p>Meet ideas through stories and familiar experiences.</p></div><div><span>02</span><strong>Practise</strong><p>Continue through language, books, and activities.</p></div><div><span>03</span><strong>Live</strong><p>Bring beneficial learning into everyday family life.</p></div></div></div></section>

  <section class="section collaboration-section"><div class="container collaboration-card"><div><span class="eyebrow">Work with Lumma</span><h2 class="title">Building something useful for Muslim families?</h2><p class="lead">We are open to meaningful collaboration with educators, writers, illustrators, developers, publishers, schools, organisations, and specialists working toward relevant educational goals.</p></div><div class="collaboration-actions"><a class="button button-primary" href={`${base}collaborate/`}>Collaborate with us</a><a class="text-link" href={`${base}team/`}>Meet the team <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
