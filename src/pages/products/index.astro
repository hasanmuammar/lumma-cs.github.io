---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/products.css';
import { products } from '../../data/products';

const base = import.meta.env.BASE_URL;

const statusClass = {
  available: 'status-available',
  'coming-soon': 'status-coming-soon',
  developing: 'status-developing'
};
---

<BaseLayout title="Products | Lumma Creative Studio" description="Explore Lumma products and educational learning experiences.">
  <section class="products-hero">
    <div class="container">
      <span class="eyebrow">Products</span>
      <h1 class="display">Explore the Lumma catalogue.</h1>
      <p class="lead">Our product catalogue brings together books, educational resources, and future learning experiences. Content channels and learning platforms are presented separately from products.</p>
      <div class="catalogue-summary" aria-label="Catalogue categories">
        <span>Books</span><span>Educational resources</span><span>Learning experiences</span>
      </div>
    </div>
  </section>

  <section class="section products-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">Current products</span><h2 class="title">Products designed for meaningful learning.</h2></div>
        <p>Each product has its own purpose and can connect with the wider Lumma learning ecosystem without being confused with a channel or platform.</p>
      </div>
      <div class="product-catalogue-grid">
        {products.map((product) => (
          <article class="catalogue-card">
            <div class="catalogue-card-top">
              <span class={`product-status ${statusClass[product.status]}`}>{product.statusLabel}</span>
              <span class="catalogue-number">{product.slug.replaceAll('-', ' ')}</span>
            </div>
            <div class="catalogue-card-body">
              <span class="eyebrow">{product.category}</span>
              <h2>{product.title}</h2>
              <p>{product.shortDescription}</p>
            </div>
            <div class="catalogue-card-footer">
              <span>{product.audience}</span>
              <a class="text-link" href={`${base}products/${product.slug}/`}>View product <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container catalogue-note">
      <div><span class="eyebrow">A growing catalogue</span><h2 class="title">Built to accommodate what comes next.</h2></div>
      <p class="lead">New books, educational resources, and other public-facing products can be added through the same structure as they become ready for presentation.</p>
    </div>
  </section>
</BaseLayout>
