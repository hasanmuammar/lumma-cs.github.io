---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';

const statusClass = {
  available: 'status-available',
  'coming-soon': 'status-coming-soon',
  developing: 'status-developing'
};
---

<BaseLayout title="Products | Lumma Creative Studio" description="Explore Lumma products, projects and educational learning experiences.">
  <section class="products-hero">
    <div class="container">
      <span class="eyebrow">Products & experiences</span>
      <h1 class="display">Explore the Lumma catalogue.</h1>
      <p class="lead">Our products bring together stories, language, faith, books, activities, and family learning. The catalogue can grow without changing the structure of the website.</p>
      <div class="catalogue-summary" aria-label="Catalogue categories">
        <span>Stories</span><span>Language</span><span>Books</span><span>Family learning</span>
      </div>
    </div>
  </section>

  <section class="section products-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">Current directions</span><h2 class="title">Products growing from the Aya universe.</h2></div>
        <p>Each product has its own focus while remaining connected to the wider learning ecosystem.</p>
      </div>
      <div class="product-catalogue-grid">
        {products.map((product) => (
          <article class="catalogue-card">
            <div class="catalogue-card-top">
              <span class={`product-status ${statusClass[product.status]}`}>{product.statusLabel}</span>
              <span class="catalogue-number">{product.slug.replaceAll('-', ' ')}</span>
            </div>
            <div class="catalogue-card-body">
              <span class="eyebrow">{product.category}</span>
              <h2>{product.title}</h2>
              <p>{product.shortDescription}</p>
            </div>
            <div class="catalogue-card-footer">
              <span>{product.audience}</span>
              <a class="text-link" href={`/products/${product.slug}/`}>View product <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container catalogue-note">
      <div><span class="eyebrow">A growing catalogue</span><h2 class="title">Built to accommodate what comes next.</h2></div>
      <p class="lead">New books, learning tools, digital experiences, and resources can be added through the same product structure as they become ready for public presentation.</p>
    </div>
  </section>
</BaseLayout>
