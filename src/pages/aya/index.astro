---
import BaseLayout from '../../layouts/BaseLayout.astro';

const areas = [
  ['Aya The Little Muslim', 'Stories, Islamic lessons, duʿā, and everyday learning.'],
  ['Aya Fun Lingua', 'Language learning through English, Arabic, and Indonesian support.'],
  ['Aya Books', 'Reading experiences, activities, and educational resources.']
];
---
<BaseLayout title="Meet Aya | Lumma Creative Studio" description="Discover Aya, the central creative and educational universe of Lumma.">
  <section class="page-hero"><div class="container"><span class="eyebrow">The Aya universe</span><h1 class="display">Meet Aya.</h1><p class="lead">Aya is a young Muslim learner growing through faith, language, family life, curiosity, stories, and everyday experiences.</p></div></section>
  <section class="section"><div class="container grid grid-2"><div><h2 class="title">A familiar world for meaningful learning.</h2><p class="lead">Aya provides continuity across different learning formats. A story can lead to a book, an activity, a language lesson, a family conversation, or another learning experience.</p></div><div class="card"><h3>Educational focus</h3><p>Faith and character, language learning, family participation, stories, creativity, and everyday practice are connected rather than treated as isolated subjects.</p></div></div></section>
  <section class="section section-soft"><div class="container"><h2 class="title">Explore Aya</h2><div class="grid grid-3">{areas.map(([title, text]) => (<article class="card"><span class="tag">Aya project</span><h3>{title}</h3><p>{text}</p></article>))}</div></div></section>
</BaseLayout>
