---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Lumma Creative Studio" description="Get in touch with Lumma Creative Studio.">
  <script>
    import '../scripts/lumma-i18n';
  </script>

  <section class="page-hero contact-hero">
    <div class="container contact-hero-grid">
      <div>
        <span class="eyebrow" data-lumma-en="Contact" data-lumma-id="Kontak">Contact</span>
        <h1 class="display" data-lumma-en="Start a conversation." data-lumma-id="Mari mulai percakapan.">Start a conversation.</h1>
        <p class="lead" data-lumma-en="For collaboration, project enquiries, or general questions, use the contact channels below." data-lumma-id="Untuk kolaborasi, pertanyaan tentang proyek, atau pertanyaan umum, gunakan saluran kontak di bawah ini.">For collaboration, project enquiries, or general questions, use the contact channels below.</p>
      </div>
      <aside class="contact-intro-card">
        <span class="tag" data-lumma-en="Lumma Creative Studio" data-lumma-id="Lumma Creative Studio">Lumma Creative Studio</span>
        <strong data-lumma-en="A simple place to start." data-lumma-id="Tempat sederhana untuk memulai.">A simple place to start.</strong>
        <p data-lumma-en="We are still finalising public contact channels. Until then, this page provides the structure for future enquiries and project communication." data-lumma-id="Kami masih menyelesaikan saluran kontak publik. Sementara itu, halaman ini menyediakan struktur untuk pertanyaan dan komunikasi proyek di masa mendatang.">We are still finalising public contact channels. Until then, this page provides the structure for future enquiries and project communication.</p>
      </aside>
    </div>
  </section>

  <section class="section contact-options-section">
    <div class="container">
      <div class="section-heading contact-heading">
        <div>
          <span class="eyebrow" data-lumma-en="Ways to connect" data-lumma-id="Cara terhubung">Ways to connect</span>
          <h2 class="title" data-lumma-en="Choose the route that fits your enquiry." data-lumma-id="Pilih jalur yang sesuai dengan kebutuhan Anda.">Choose the route that fits your enquiry.</h2>
        </div>
      </div>
      <div class="contact-options-grid">
        <article class="contact-option-card">
          <span class="contact-option-index">01</span>
          <h2>Email</h2>
          <p data-lumma-en="Public contact details will be confirmed before launch. This space is reserved for the main studio contact channel." data-lumma-id="Detail kontak publik akan dikonfirmasi sebelum peluncuran. Ruang ini disiapkan untuk saluran kontak utama studio.">Public contact details will be confirmed before launch. This space is reserved for the main studio contact channel.</p>
        </article>
        <article class="contact-option-card">
          <span class="contact-option-index">02</span>
          <h2 data-lumma-en="Project channels" data-lumma-id="Saluran proyek">Project channels</h2>
          <p data-lumma-en="Relevant public channels for Aya and other Lumma projects can be linked here as the public ecosystem develops." data-lumma-id="Saluran publik yang relevan untuk Aya dan proyek Lumma lainnya dapat ditautkan di sini seiring berkembangnya ekosistem publik.">Relevant public channels for Aya and other Lumma projects can be linked here as the public ecosystem develops.</p>
        </article>
        <article class="contact-option-card">
          <span class="contact-option-index">03</span>
          <h2 data-lumma-en="Collaboration" data-lumma-id="Kolaborasi">Collaboration</h2>
          <p data-lumma-en="If you are interested in working with Lumma, the collaboration page explains the kinds of conversations and projects we are open to exploring." data-lumma-id="Jika Anda tertarik untuk bekerja sama dengan Lumma, halaman kolaborasi menjelaskan jenis percakapan dan proyek yang terbuka untuk dijajaki.">If you are interested in working with Lumma, the collaboration page explains the kinds of conversations and projects we are open to exploring.</p>
          <a class="text-link" href={`${import.meta.env.BASE_URL}collaborate/`} data-lumma-en="Explore collaboration" data-lumma-id="Jelajahi kolaborasi">Explore collaboration</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
