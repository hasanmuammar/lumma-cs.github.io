---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Lumma Creative Studio" description="Get in touch with Lumma Creative Studio.">
  <script>
    import '../scripts/lumma-i18n';
  </script>

  <section class="page-hero"><div class="container"><span class="eyebrow" data-lumma-en="Contact" data-lumma-id="Kontak">Contact</span><h1 class="display" data-lumma-en="Start a conversation." data-lumma-id="Mari mulai percakapan.">Start a conversation.</h1><p class="lead" data-lumma-en="For collaboration, project enquiries, or general questions, use the contact channels below." data-lumma-id="Untuk kolaborasi, pertanyaan tentang proyek, atau pertanyaan umum, gunakan saluran kontak di bawah ini.">For collaboration, project enquiries, or general questions, use the contact channels below.</p></div></section>
  <section class="section"><div class="container grid grid-2"><article class="card"><h2>Email</h2><p data-lumma-en="Public contact details will be confirmed before launch." data-lumma-id="Detail kontak publik akan dikonfirmasi sebelum peluncuran.">Public contact details will be confirmed before launch.</p></article><article class="card"><h2 data-lumma-en="Social media" data-lumma-id="Media sosial">Social media</h2><p data-lumma-en="Relevant public project channels can be linked here as the new website structure is finalised." data-lumma-id="Kanal proyek publik yang relevan akan ditautkan di sini setelah struktur situs baru selesai.">Relevant public project channels can be linked here as the new website structure is finalised.</p></article></div></section>
</BaseLayout>
