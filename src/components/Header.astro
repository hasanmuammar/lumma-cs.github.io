---
import LanguageSwitcher from './LanguageSwitcherClient.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalized = (path: string) => path.replace(/\/$/, '') || '/';
const isActive = (path: string) => currentPath === normalized(path) || currentPath.startsWith(`${normalized(path)}/`);
const isHome = currentPath === normalized(base);
const isAya = isActive(`${base}aya/`);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href={base} aria-label="Lumma Creative Studio home">
      <img class="brand-logo" src={`${base}images/logo/lumma-logo.png`} alt="Lumma Creative Studio" />
    </a>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation"
    >
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav class="nav-links" id="primary-navigation" aria-label="Primary navigation">
      <a class="nav-link" href={base} aria-current={isHome ? 'page' : undefined} data-i18n="Home">Home</a>
      <a class="nav-link" href={`${base}about/`} aria-current={isActive(`${base}about/`) ? 'page' : undefined} data-i18n="About">About</a>

      <details class="nav-group" open={isAya}>
        <summary class="nav-link nav-link-group" data-i18n="Aya">
          <span>Aya</span><span class="nav-chevron" aria-hidden="true"></span>
        </summary>
        <div class="nav-popover">
          <a href={`${base}aya/`} aria-current={currentPath === normalized(`${base}aya/`) ? 'page' : undefined} data-i18n="Aya universe">Aya universe</a>
          <a href={`${base}aya/aya-the-little-muslim/`} aria-current={currentPath === normalized(`${base}aya/aya-the-little-muslim/`) ? 'page' : undefined} data-i18n="Aya The Little Muslim">Aya The Little Muslim</a>
          <a href={`${base}aya/aya-fun-lingua/`} aria-current={currentPath === normalized(`${base}aya/aya-fun-lingua/`) ? 'page' : undefined} data-i18n="Aya Fun Lingua">Aya Fun Lingua</a>
        </div>
      </details>

      <a class="nav-link" href={`${base}products/`} aria-current={isActive(`${base}products/`) ? 'page' : undefined} data-i18n="Products">Products</a>
      <a class="nav-link" href={`${base}resources/`} aria-current={isActive(`${base}resources/`) ? 'page' : undefined} data-i18n="Resources">Resources</a>
      <a class="nav-link" href={`${base}collaborate/`} aria-current={isActive(`${base}collaborate/`) ? 'page' : undefined} data-i18n="Collaborate">Collaborate</a>
      <a class="nav-link nav-contact-link" href={`${base}contact/`} aria-current={isActive(`${base}contact/`) ? 'page' : undefined} data-i18n="Contact">Contact</a>
      <div class="nav-language"><LanguageSwitcher /></div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');
  const navGroups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-group'));

  const closeSubmenus = (except?: HTMLDetailsElement) => {
    navGroups.forEach((group) => {
      if (group !== except) group.removeAttribute('open');
    });
  };

  const closeNavigation = () => {
    navigation?.classList.remove('is-open');
    button?.setAttribute('aria-expanded', 'false');
    closeSubmenus();
  };

  button?.addEventListener('click', () => {
    const isOpen = navigation?.classList.toggle('is-open') ?? false;
    button.setAttribute('aria-expanded', String(isOpen));
    button.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
    if (!isOpen) closeSubmenus();
  });

  navGroups.forEach((group) => {
    group.addEventListener('toggle', () => {
      if (group.open) closeSubmenus(group);
    });
  });

  navigation?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.addEventListener('click', closeNavigation);
  });

  header?.addEventListener('mouseleave', () => closeSubmenus());

  document.addEventListener('pointerdown', (event) => {
    const target = event.target as Node;
    const clickedInsideGroup = navGroups.some((group) => group.contains(target));
    if (!clickedInsideGroup) closeSubmenus();
    if (header && !header.contains(target)) closeNavigation();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeNavigation();
  });
</script>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: color-mix(in srgb, var(--page-bg) 94%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }

  .site-header .nav {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    text-decoration: none;
  }

  .site-header .brand-logo {
    display: block;
    width: clamp(7.25rem, 10vw, 9rem);
    height: auto;
  }

  .site-header .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .2rem;
    margin-left: auto;
    color: var(--text-muted);
    font-size: .9375rem;
  }

  .site-header .nav-link,
  .site-header .nav-group > summary {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: .4rem;
    padding: .65rem .55rem;
    color: var(--text-muted);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    border-radius: .5rem;
    transition: color .18s ease, background-color .18s ease;
  }

  .site-header .nav-link:hover,
  .site-header .nav-link:focus-visible,
  .site-header .nav-link[aria-current="page"],
  .site-header .nav-group > summary:hover,
  .site-header .nav-group > summary:focus-visible,
  .site-header .nav-group > summary.active {
    color: var(--text);
    background: color-mix(in srgb, var(--surface-soft) 72%, transparent);
  }

  .site-header .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: .55rem;
    bottom: .3rem;
    left: .55rem;
    height: 2px;
    border-radius: 2px;
    background: var(--lumma-orange);
  }

  .site-header .nav-group {
    position: relative;
  }

  .site-header .nav-group > summary {
    list-style: none;
    cursor: pointer;
  }

  .site-header .nav-group > summary::-webkit-details-marker {
    display: none;
  }

  .site-header .nav-chevron {
    width: .4rem;
    height: .4rem;
    margin-top: -.15rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform .18s ease;
  }

  .site-header .nav-group[open] .nav-chevron {
    transform: rotate(225deg) translate(-1px, -1px);
  }

  .site-header .nav-popover {
    position: absolute;
    top: calc(100% + .35rem);
    left: 50%;
    z-index: 20;
    width: min(19rem, calc(100vw - 2rem));
    padding: .4rem;
    transform: translateX(-50%);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: .7rem;
    box-shadow: var(--shadow-md);
  }

  .site-header .nav-popover a {
    display: block;
    min-height: 2.75rem;
    padding: .7rem .8rem;
    color: var(--text-muted);
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
    border-radius: .45rem;
  }

  .site-header .nav-popover a:hover,
  .site-header .nav-popover a:focus-visible,
  .site-header .nav-popover a[aria-current="page"] {
    color: var(--text);
    background: var(--surface-soft);
  }

  .site-header .nav-actions,
  .site-header .nav-language {
    display: inline-flex;
    align-items: center;
    margin-left: .4rem;
    padding-left: .45rem;
    border-left: 1px solid var(--border);
  }

  .site-header .nav-contact-link {
    margin-left: .1rem;
  }

  .site-header .menu-button {
    display: none;
    min-height: 2.75rem;
    align-items: center;
    gap: .5rem;
    padding: .55rem .25rem;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .site-header .menu-label {
    font-size: .85rem;
    font-weight: 700;
  }

  .site-header .menu-icon {
    display: grid;
    width: 1.3rem;
    gap: .22rem;
  }

  .site-header .menu-icon i {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  @media (max-width: 980px) {
    .site-header .nav-links {
      gap: .05rem;
    }

    .site-header .nav-link,
    .site-header .nav-group > summary {
      padding-inline: .45rem;
    }
  }

  @media (max-width: 900px) {
    .site-header .nav {
      min-height: 4.25rem;
    }

    .site-header .menu-button {
      display: inline-flex;
      margin-left: auto;
    }

    .site-header .nav-links {
      position: absolute;
      top: calc(100% + .5rem);
      right: var(--gutter);
      left: var(--gutter);
      display: none;
      align-items: stretch;
      flex-direction: column;
      gap: .1rem;
      padding: .5rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: .75rem;
      box-shadow: var(--shadow-md);
    }

    .site-header .nav-links.is-open {
      display: flex;
    }

    .site-header .nav-link,
    .site-header .nav-group > summary {
      width: 100%;
      justify-content: space-between;
      padding: .75rem .8rem;
    }

    .site-header .nav-link[aria-current="page"]::after {
      right: auto;
      bottom: .5rem;
      left: .8rem;
      width: 1.4rem;
    }

    .site-header .nav-group {
      width: 100%;
    }

    .site-header .nav-popover {
      position: static;
      width: auto;
      margin: 0 .35rem .25rem;
      padding: .25rem;
      transform: none;
      box-shadow: none;
      background: var(--surface-soft);
    }

    .site-header .nav-actions,
    .site-header .nav-language {
      width: 100%;
      margin: .2rem 0 0;
      padding: .4rem .8rem 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header .nav-link,
    .site-header .nav-group > summary,
    .site-header .nav-chevron { transition: none; }
  }
</style>
