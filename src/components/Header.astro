---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalized = (path: string) => path.replace(/\/$/, '') || '/';
const isActive = (path: string) => currentPath === normalized(path) || currentPath.startsWith(`${normalized(path)}/`);
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={base} aria-label="Lumma Creative Studio home">
      <span class="brand-mark" aria-hidden="true">L</span>
      <span>Lumma Creative Studio</span>
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation">
      <span aria-hidden="true">Menu</span>
    </button>

    <nav class="nav-links" id="primary-navigation" aria-label="Primary navigation">
      <a href={`${base}about/`} aria-current={isActive(`${base}about/`) ? 'page' : undefined}>About</a>

      <details class="nav-group">
        <summary class:list={{ active: isActive(`${base}aya/`) }}>Aya</summary>
        <div class="nav-popover">
          <a href={`${base}aya/`}>Aya universe</a>
          <a href={`${base}aya/aya-the-little-muslim/`}>Aya The Little Muslim</a>
          <a href={`${base}aya/aya-fun-lingua/`}>Aya Fun Lingua</a>
          <a href={`${base}products/aya-books/`}>Aya Books</a>
        </div>
      </details>

      <details class="nav-group">
        <summary class:list={{ active: isActive(`${base}products/`) }}>Products</summary>
        <div class="nav-popover">
          <a href={`${base}products/`}>All products</a>
          <a href={`${base}products/aya-books/`}>Aya Books</a>
        </div>
      </details>

      <a href={`${base}team/`} aria-current={isActive(`${base}team/`) ? 'page' : undefined}>Team</a>
      <a href={`${base}collaborate/`} aria-current={isActive(`${base}collaborate/`) ? 'page' : undefined}>Collaborate</a>
      <a class="button button-primary nav-contact" href={`${base}contact/`}>Contact</a>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector('.menu-button');
  const navigation = document.querySelector('#primary-navigation');

  button?.addEventListener('click', () => {
    const isOpen = navigation?.classList.toggle('is-open');
    button.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  navigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      navigation.classList.remove('is-open');
      button?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
