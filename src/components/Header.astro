---
import LanguageSwitcher from './LanguageSwitcherClient.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalized = (path: string) => path.replace(/\/$/, '') || '/';
const isActive = (path: string) => currentPath === normalized(path) || currentPath.startsWith(`${normalized(path)}/`);
const isHome = currentPath === normalized(base);
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={base} aria-label="Lumma Creative Studio home">
      <img class="brand-logo" src={`${base}images/logo/lumma-logo.png`} alt="Lumma Creative Studio" />
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation">
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>

    <nav class="nav-links" id="primary-navigation" aria-label="Primary navigation">
      <a href={base} aria-current={isHome ? 'page' : undefined} data-i18n="Home">Home</a>
      <a href={`${base}about/`} aria-current={isActive(`${base}about/`) ? 'page' : undefined} data-i18n="About">About</a>
      <details class="nav-group">
        <summary class:list={{ active: isActive(`${base}aya/`) }} data-i18n="Aya">Aya</summary>
        <div class="nav-popover">
          <a href={`${base}aya/`} data-i18n="Aya universe">Aya universe</a>
          <a href={`${base}aya/aya-the-little-muslim/`} data-i18n="Aya The Little Muslim">Aya The Little Muslim</a>
          <a href={`${base}aya/aya-fun-lingua/`} data-i18n="Aya Fun Lingua">Aya Fun Lingua</a>
        </div>
      </details>
      <a href={`${base}products/`} aria-current={isActive(`${base}products/`) ? 'page' : undefined} data-i18n="Products">Products</a>
      <a href={`${base}resources/`} aria-current={isActive(`${base}resources/`) ? 'page' : undefined} data-i18n="Resources">Resources</a>
      <a href={`${base}collaborate/`} aria-current={isActive(`${base}collaborate/`) ? 'page' : undefined} data-i18n="Collaborate">Collaborate</a>
      <div class="nav-actions">
        <a class="nav-contact-link" href={`${base}contact/`} aria-current={isActive(`${base}contact/`) ? 'page' : undefined} data-i18n="Contact">Contact</a>
        <LanguageSwitcher />
      </div>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');
  const navGroups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-group'));

  const closeSubmenus = (except?: HTMLDetailsElement) => {
    navGroups.forEach((group) => {
      if (group !== except) group.removeAttribute('open');
    });
  };

  button?.addEventListener('click', () => {
    const isOpen = navigation?.classList.toggle('is-open');
    button.setAttribute('aria-expanded', String(Boolean(isOpen)));
    if (!isOpen) closeSubmenus();
  });

  navGroups.forEach((group) => {
    group.addEventListener('toggle', () => {
      if (group.open) closeSubmenus(group);
    });
  });

  navigation?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.addEventListener('click', () => {
      navigation.classList.remove('is-open');
      button?.setAttribute('aria-expanded', 'false');
      closeSubmenus();
    });
  });

  header?.addEventListener('mouseleave', () => closeSubmenus());

  document.addEventListener('pointerdown', (event) => {
    const target = event.target as Node;
    const clickedGroup = navGroups.find((group) => group.contains(target));
    if (!clickedGroup) closeSubmenus();

    if (header && !header.contains(target)) {
      navigation?.classList.remove('is-open');
      button?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeSubmenus();
      navigation?.classList.remove('is-open');
      button?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
