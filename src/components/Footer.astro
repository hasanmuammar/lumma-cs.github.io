---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>Lumma Creative Studio</strong>
      <p class="lead">A growing creative and educational studio developing meaningful learning experiences for Muslim families.</p>
      <small>© {new Date().getFullYear()} Lumma Creative Studio.</small>
    </div>
    <div>
      <strong>Explore</strong>
      <p><a href={`${base}aya/`}>Aya</a></p>
      <p><a href={`${base}products/`}>Products</a></p>
      <p><a href={`${base}about/`}>About Lumma</a></p>
    </div>
    <div>
      <strong>Connect</strong>
      <p><a href={`${base}team/`}>Our Team</a></p>
      <p><a href={`${base}collaborate/`}>Collaborate</a></p>
      <p><a href={`${base}contact/`}>Contact</a></p>
    </div>
  </div>
</footer>
